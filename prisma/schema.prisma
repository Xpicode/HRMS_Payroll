// HRMS + Payroll — Phase 0 schema (auth, companies, holidays, audit).
// Later phases append models; never delete or rename applied migrations.
//
// Conventions
// - Every tenant table carries `companyId` (column company_id). Queries on tenant
//   tables go through src/lib/scope.ts.
// - Dates that are calendar dates (holidays, effective dates) are `@db.Date`.
// - Timestamps are `timestamptz`. Timezone handling lives in src/lib/dates.ts.
// - Money and rates are `Decimal` — never Float.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// auth
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  PAYROLL_OFFICER
  ENCODER
}

model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  email              String    @unique
  name               String
  passwordHash       String    @map("password_hash")
  role               Role      @default(ENCODER)
  isActive           Boolean   @default(true) @map("is_active")
  // security
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(3)
  passwordChangedAt  DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  companies       UserCompany[]
  auditLogs       AuditLog[]
  approvedPeriods PayPeriod[]         @relation("PayPeriodApprovedBy")
  adjustments     PayrollAdjustment[]

  @@map("users")
}

model UserCompany {
  userId    String   @map("user_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@index([companyId])
  @@map("user_companies")
}

// ---------------------------------------------------------------------------
// companies
// ---------------------------------------------------------------------------

enum PayFrequency {
  SEMI_MONTHLY
  MONTHLY
}

enum PaperSize {
  LETTER
  A4
}

enum PaperOrientation {
  LANDSCAPE
  PORTRAIT
}

enum StatutoryTiming {
  FIRST_CUTOFF
  SECOND_CUTOFF
  SPLIT
}

model Company {
  id                   String           @id @default(uuid(7)) @db.Uuid
  code                 String           @unique
  legalName            String           @map("legal_name")
  tradeName            String?          @map("trade_name")
  address              String
  tin                  String?
  sssEmployerNo        String?          @map("sss_employer_no")
  philhealthEmployerNo String?          @map("philhealth_employer_no")
  pagibigEmployerNo    String?          @map("pagibig_employer_no")
  logoPath             String?          @map("logo_path")
  payFrequency         PayFrequency     @default(SEMI_MONTHLY) @map("pay_frequency")
  signatoryName        String           @map("signatory_name")
  signatoryTitle       String           @map("signatory_title")
  slipCodePrefix       String           @map("slip_code_prefix")
  slipCodeNext         Int              @default(1) @map("slip_code_next")
  slipCodePad          Int              @default(3) @map("slip_code_pad")
  employeeNoPrefix     String           @default("EMP") @map("employee_no_prefix")
  employeeNoNext       Int              @default(1) @map("employee_no_next")
  employeeNoPad        Int              @default(4) @map("employee_no_pad")
  /// Payslip paper (Phase 5): Letter/A4, landscape/portrait.
  paperSize            PaperSize        @default(LETTER) @map("paper_size")
  paperOrientation     PaperOrientation @default(LANDSCAPE) @map("paper_orientation")
  isActive             Boolean          @default(true) @map("is_active")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  users          UserCompany[]
  policies       CompanyPayrollPolicy[]
  holidays       Holiday[]
  auditLogs      AuditLog[]
  employees      Employee[]
  paySettings    EmployeePaySetting[]
  recurringItems EmployeeRecurringItem[]
  timeRecords    DailyTimeRecord[]
  payPeriods     PayPeriod[]
  payslips       Payslip[]
  loans          Loan[]
  jobs           Job[]

  @@map("companies")
}

/// One row per company per effective date. The engine picks the latest row
/// whose effective_from <= the pay period's coverage_end.
model CompanyPayrollPolicy {
  id                     String          @id @default(uuid(7)) @db.Uuid
  companyId              String          @map("company_id") @db.Uuid
  effectiveFrom          DateTime        @map("effective_from") @db.Date
  workingDaysPerYear     Int             @default(313) @map("working_days_per_year")
  hoursPerDay            Decimal         @default(8) @map("hours_per_day") @db.Decimal(4, 2)
  otRegular              Decimal         @default(1.25) @map("ot_regular") @db.Decimal(6, 4)
  otRestDay              Decimal         @default(1.30) @map("ot_rest_day") @db.Decimal(6, 4)
  otRestDayExcess        Decimal         @default(1.69) @map("ot_rest_day_excess") @db.Decimal(6, 4)
  otRegularHoliday       Decimal         @default(2.00) @map("ot_regular_holiday") @db.Decimal(6, 4)
  otRegularHolidayExcess Decimal         @default(2.60) @map("ot_regular_holiday_excess") @db.Decimal(6, 4)
  nightDiffRate          Decimal         @default(0.10) @map("night_diff_rate") @db.Decimal(6, 4)
  statutoryTiming        StatutoryTiming @default(SECOND_CUTOFF) @map("statutory_timing")
  /// When false only an ADMIN may approve, release or lock a pay period.
  officerCanApprove      Boolean         @default(true) @map("officer_can_approve")
  lateGraceMinutes       Int             @default(0) @map("late_grace_minutes")
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, effectiveFrom])
  @@map("company_payroll_policies")
}

enum HolidayType {
  REGULAR
  SPECIAL_NON_WORKING
  SPECIAL_WORKING
}

/// companyId NULL = national holiday visible to every company.
model Holiday {
  id        String      @id @default(uuid(7)) @db.Uuid
  companyId String?     @map("company_id") @db.Uuid
  date      DateTime    @db.Date
  name      String
  type      HolidayType
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
  @@index([date])
  @@map("holidays")
}

// ---------------------------------------------------------------------------
// audit — append-only. The application never updates or deletes rows here.
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  companyId String?  @map("company_id") @db.Uuid
  entity    String
  entityId  String   @map("entity_id")
  action    String
  before    Json?
  after     Json?
  ip        String?
  at        DateTime @default(now()) @db.Timestamptz(3)

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([companyId, at])
  @@index([userId, at])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// employees (Phase 1) — 201 record, effective-dated pay settings, recurring items
// ---------------------------------------------------------------------------

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SEPARATED
}

enum PayType {
  MONTHLY
  DAILY
  COMMISSION
}

/// BIR tax status codes kept for the 201 record and 2316; withholding under TRAIN does not depend on them.
enum TaxStatus {
  S
  ME
  S1
  S2
  S3
  S4
  ME1
  ME2
  ME3
  ME4
}

enum RecurringItemKind {
  EARNING
  DEDUCTION
}

model Employee {
  id             String         @id @default(uuid(7)) @db.Uuid
  companyId      String         @map("company_id") @db.Uuid
  employeeNo     String         @map("employee_no")
  lastName       String         @map("last_name")
  firstName      String         @map("first_name")
  middleName     String?        @map("middle_name")
  suffix         String?
  birthDate      DateTime?      @map("birth_date") @db.Date
  hireDate       DateTime       @map("hire_date") @db.Date
  separationDate DateTime?      @map("separation_date") @db.Date
  status         EmployeeStatus @default(ACTIVE)
  position       String?
  department     String?
  email          String?
  mobile         String?
  address        String?
  /// Government IDs are stored as digits only; formatting is applied when printed.
  sssNo          String?        @map("sss_no")
  philhealthNo   String?        @map("philhealth_no")
  pagibigMid     String?        @map("pagibig_mid")
  tin            String?
  taxStatus      TaxStatus      @default(S) @map("tax_status")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  paySettings    EmployeePaySetting[]
  recurringItems EmployeeRecurringItem[]
  timeRecords    DailyTimeRecord[]
  payslips       Payslip[]
  adjustments    PayrollAdjustment[]
  loans          Loan[]

  @@unique([companyId, employeeNo])
  @@index([companyId, status])
  @@index([companyId, lastName, firstName])
  @@map("employees")
}

/// One row per change of pay terms. The row in force on a date is the latest with effective_from <= date.
model EmployeePaySetting {
  id                  String       @id @default(uuid(7)) @db.Uuid
  companyId           String       @map("company_id") @db.Uuid
  employeeId          String       @map("employee_id") @db.Uuid
  effectiveFrom       DateTime     @map("effective_from") @db.Date
  payType             PayType      @map("pay_type")
  monthlyRate         Decimal?     @map("monthly_rate") @db.Decimal(12, 2)
  dailyRate           Decimal?     @map("daily_rate") @db.Decimal(12, 2)
  payFrequency        PayFrequency @map("pay_frequency")
  isMinimumWageEarner Boolean      @default(false) @map("is_minimum_wage_earner")
  sssCovered          Boolean      @default(true) @map("sss_covered")
  philhealthCovered   Boolean      @default(true) @map("philhealth_covered")
  pagibigCovered      Boolean      @default(true) @map("pagibig_covered")
  taxWithheld         Boolean      @default(true) @map("tax_withheld")
  /// 0 = Sunday … 6 = Saturday. Drives the default REST_DAY day type in attendance.
  restDayOfWeek       Int          @default(0) @map("rest_day_of_week")
  /// Scheduled shift ("HH:MM") and unpaid break, used to derive lates/undertime/OT.
  shiftStart          String       @default("08:00") @map("shift_start")
  shiftEnd            String       @default("17:00") @map("shift_end")
  breakMinutes        Int          @default(60) @map("break_minutes")
  note                String?
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, effectiveFrom])
  @@index([companyId])
  @@map("employee_pay_settings")
}

/// Fixed allowances or deductions applied every period while in effect.
model EmployeeRecurringItem {
  id            String            @id @default(uuid(7)) @db.Uuid
  companyId     String            @map("company_id") @db.Uuid
  employeeId    String            @map("employee_id") @db.Uuid
  componentCode String            @map("component_code")
  kind          RecurringItemKind
  label         String
  amount        Decimal           @db.Decimal(12, 2)
  effectiveFrom DateTime          @map("effective_from") @db.Date
  effectiveTo   DateTime?         @map("effective_to") @db.Date
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, effectiveFrom])
  @@index([companyId])
  @@map("employee_recurring_items")
}

// ---------------------------------------------------------------------------
// attendance (Phase 2) — one row per employee per day
// ---------------------------------------------------------------------------

enum DayType {
  REGULAR
  REST_DAY
  SPECIAL_NON_WORKING
  SPECIAL_WORKING
  REGULAR_HOLIDAY
}

enum DtrSource {
  MANUAL
  IMPORT
  SCAN
}

/// Inputs (time in/out) and the computed figures are both stored so the cutoff summary
/// and the payroll engine read plain columns. Computation lives in src/modules/attendance/compute.ts.
model DailyTimeRecord {
  id               String    @id @default(uuid(7)) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  employeeId       String    @map("employee_id") @db.Uuid
  date             DateTime  @db.Date
  dayType          DayType   @map("day_type")
  /// "HH:MM" 24-hour; both present = hours/late/undertime derived from them.
  timeIn           String?   @map("time_in")
  timeOut          String?   @map("time_out")
  hoursWorked      Decimal   @default(0) @map("hours_worked") @db.Decimal(5, 2)
  lateMinutes      Int       @default(0) @map("late_minutes")
  undertimeMinutes Int       @default(0) @map("undertime_minutes")
  otHours          Decimal   @default(0) @map("ot_hours") @db.Decimal(5, 2)
  nightDiffHours   Decimal   @default(0) @map("night_diff_hours") @db.Decimal(5, 2)
  isAbsent         Boolean   @default(false) @map("is_absent")
  remarks          String?
  source           DtrSource @default(MANUAL)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([companyId, date])
  @@map("daily_time_records")
}

// ---------------------------------------------------------------------------
// Statutory tables (global, effective-dated) and pay components — Phase 3
// ---------------------------------------------------------------------------

/// One bracket of the SSS contribution schedule. Salary range -> monthly salary credit and shares.
/// `wispEe/wispEr` are the mandatory provident fund (MPF/WISP) shares on the MSC portion above ₱20,000.
model SssTable {
  id            String   @id @default(uuid(7)) @db.Uuid
  effectiveFrom DateTime @map("effective_from") @db.Date
  minSalary     Decimal  @map("min_salary") @db.Decimal(12, 2)
  /// null = no upper bound
  maxSalary     Decimal? @map("max_salary") @db.Decimal(12, 2)
  msc           Decimal  @db.Decimal(12, 2)
  eeShare       Decimal  @map("ee_share") @db.Decimal(12, 2)
  erShare       Decimal  @map("er_share") @db.Decimal(12, 2)
  ecShare       Decimal  @map("ec_share") @db.Decimal(12, 2)
  wispEe        Decimal  @default(0) @map("wisp_ee") @db.Decimal(12, 2)
  wispEr        Decimal  @default(0) @map("wisp_er") @db.Decimal(12, 2)

  @@unique([effectiveFrom, msc])
  @@index([effectiveFrom])
  @@map("sss_tables")
}

model PhilhealthRule {
  id            String   @id @default(uuid(7)) @db.Uuid
  effectiveFrom DateTime @unique @map("effective_from") @db.Date
  /// Total premium rate on the monthly basic salary, split equally EE/ER.
  rate          Decimal  @db.Decimal(6, 4)
  floorSalary   Decimal  @map("floor_salary") @db.Decimal(12, 2)
  ceilingSalary Decimal  @map("ceiling_salary") @db.Decimal(12, 2)

  @@map("philhealth_rules")
}

model PagibigRule {
  id                 String   @id @default(uuid(7)) @db.Uuid
  effectiveFrom      DateTime @unique @map("effective_from") @db.Date
  eeRate             Decimal  @map("ee_rate") @db.Decimal(6, 4)
  erRate             Decimal  @map("er_rate") @db.Decimal(6, 4)
  maxFundSalary      Decimal  @map("max_fund_salary") @db.Decimal(12, 2)
  lowIncomeThreshold Decimal  @map("low_income_threshold") @db.Decimal(12, 2)
  lowIncomeEeRate    Decimal  @map("low_income_ee_rate") @db.Decimal(6, 4)

  @@map("pagibig_rules")
}

/// BIR withholding tax table row: tax = baseTax + (taxable − lower) × rateOver for lower <= taxable < upper.
model TaxBracket {
  id            String       @id @default(uuid(7)) @db.Uuid
  effectiveFrom DateTime     @map("effective_from") @db.Date
  frequency     PayFrequency
  lower         Decimal      @db.Decimal(12, 2)
  /// null = no upper bound
  upper         Decimal?     @db.Decimal(12, 2)
  baseTax       Decimal      @map("base_tax") @db.Decimal(12, 2)
  rateOver      Decimal      @map("rate_over") @db.Decimal(6, 4)

  @@unique([effectiveFrom, frequency, lower])
  @@index([effectiveFrom, frequency])
  @@map("tax_brackets")
}

enum PayComponentKind {
  EARNING
  DEDUCTION
}

/// Catalogue of payslip line types. `order` is the position on the payslip; `isSystem` rows are
/// produced by the engine and cannot be deleted.
model PayComponent {
  code     String           @id
  name     String
  kind     PayComponentKind
  taxable  Boolean          @default(false)
  order    Int
  isSystem Boolean          @default(false) @map("is_system")

  @@map("pay_components")
}

// ---------------------------------------------------------------------------
// Pay periods, payslips, adjustments, loans — Phase 4
// ---------------------------------------------------------------------------

enum PayPeriodStatus {
  DRAFT
  COMPUTED
  APPROVED
  RELEASED
  LOCKED
}

/// One payroll run for a company cutoff. Status drives what may change: payslips and lines
/// are immutable once APPROVED (repo guard + database trigger, see the migration).
model PayPeriod {
  id              String          @id @default(uuid(7)) @db.Uuid
  companyId       String          @map("company_id") @db.Uuid
  coverageStart   DateTime        @map("coverage_start") @db.Date
  coverageEnd     DateTime        @map("coverage_end") @db.Date
  payDate         DateTime        @map("pay_date") @db.Date
  frequency       PayFrequency
  sequenceInMonth Int             @map("sequence_in_month")
  status          PayPeriodStatus @default(DRAFT)
  computedAt      DateTime?       @map("computed_at") @db.Timestamptz(3)
  approvedById    String?         @map("approved_by") @db.Uuid
  approvedAt      DateTime?       @map("approved_at") @db.Timestamptz(3)
  releasedAt      DateTime?       @map("released_at") @db.Timestamptz(3)
  lockedAt        DateTime?       @map("locked_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  approvedBy   User?               @relation("PayPeriodApprovedBy", fields: [approvedById], references: [id])
  payslips     Payslip[]
  adjustments  PayrollAdjustment[]
  loanPayments LoanPayment[]

  @@unique([companyId, coverageStart])
  @@index([companyId, status])
  @@map("pay_periods")
}

/// One employee's pay for a period. `snapshot` is filled on approval and is the only source
/// for PDFs and reports from then on; totals are copied out for listing.
model Payslip {
  id              String    @id @default(uuid(7)) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  payPeriodId     String    @map("pay_period_id") @db.Uuid
  employeeId      String    @map("employee_id") @db.Uuid
  slipCode        String?   @map("slip_code")
  snapshot        Json?
  daysWorked      Decimal   @default(0) @map("days_worked") @db.Decimal(5, 2)
  otHours         Decimal   @default(0) @map("ot_hours") @db.Decimal(6, 2)
  grossPay        Decimal   @map("gross_pay") @db.Decimal(12, 2)
  totalDeductions Decimal   @map("total_deductions") @db.Decimal(12, 2)
  netPay          Decimal   @map("net_pay") @db.Decimal(12, 2)
  taxableIncome   Decimal   @default(0) @map("taxable_income") @db.Decimal(12, 2)
  /// Engine flags (code + message) for the review table.
  flags           Json      @default("[]")
  /// The engine's full input and output for the last computation (working copy before approval).
  computation     Json
  pdfPath         String?   @map("pdf_path")
  generatedAt     DateTime? @map("generated_at") @db.Timestamptz(3)
  computedAt      DateTime  @default(now()) @map("computed_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payPeriod    PayPeriod     @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  lines        PayslipLine[]
  loanPayments LoanPayment[]

  @@unique([payPeriodId, employeeId])
  @@unique([companyId, slipCode])
  @@index([companyId, employeeId])
  @@map("payslips")
}

model PayslipLine {
  id            String           @id @default(uuid(7)) @db.Uuid
  companyId     String           @map("company_id") @db.Uuid
  payslipId     String           @map("payslip_id") @db.Uuid
  componentCode String           @map("component_code")
  label         String
  kind          PayComponentKind
  quantity      Decimal?         @db.Decimal(10, 2)
  unit          String?
  rate          Decimal?         @db.Decimal(12, 4)
  amount        Decimal          @db.Decimal(12, 2)
  taxable       Boolean          @default(false)
  isManual      Boolean          @default(false) @map("is_manual")
  note          String?
  /// Position on the payslip (component order, then insertion).
  order         Int

  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([payslipId])
  @@index([companyId])
  @@map("payslip_lines")
}

/// A manual earning or deduction for one employee in one period. Merged by the engine on
/// every (re)compute so it survives recomputation; deleted with the period.
model PayrollAdjustment {
  id            String           @id @default(uuid(7)) @db.Uuid
  companyId     String           @map("company_id") @db.Uuid
  payPeriodId   String           @map("pay_period_id") @db.Uuid
  employeeId    String           @map("employee_id") @db.Uuid
  componentCode String           @map("component_code")
  kind          PayComponentKind
  label         String
  amount        Decimal          @db.Decimal(12, 2)
  reason        String
  createdById   String?          @map("created_by") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  payPeriod PayPeriod @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id])

  @@index([payPeriodId, employeeId])
  @@index([companyId])
  @@map("payroll_adjustments")
}

enum LoanType {
  SSS_LOAN
  PAGIBIG_LOAN
  CASH_ADVANCE
  OTHER
}

enum LoanStatus {
  ACTIVE
  PAID
  CANCELLED
}

/// Employee loan or cash advance. `amortization` is deducted per pay period starting with the
/// first period whose coverage ends on/after `startDate`; deductions stop at zero balance.
model Loan {
  id           String     @id @default(uuid(7)) @db.Uuid
  companyId    String     @map("company_id") @db.Uuid
  employeeId   String     @map("employee_id") @db.Uuid
  type         LoanType
  label        String
  principal    Decimal    @db.Decimal(12, 2)
  amortization Decimal    @db.Decimal(12, 2)
  startDate    DateTime   @map("start_date") @db.Date
  balance      Decimal    @db.Decimal(12, 2)
  status       LoanStatus @default(ACTIVE)
  note         String?
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payments LoanPayment[]

  @@index([employeeId, status])
  @@index([companyId, status])
  @@map("loans")
}

/// Posted when a period is approved; deleted (and the balance restored) when it is reverted.
model LoanPayment {
  id           String   @id @default(uuid(7)) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  loanId       String   @map("loan_id") @db.Uuid
  payslipId    String   @map("payslip_id") @db.Uuid
  payPeriodId  String   @map("pay_period_id") @db.Uuid
  amount       Decimal  @db.Decimal(12, 2)
  balanceAfter Decimal  @map("balance_after") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  loan      Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)
  payslip   Payslip   @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  payPeriod PayPeriod @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)

  @@unique([loanId, payslipId])
  @@index([companyId])
  @@map("loan_payments")
}

// ---------------------------------------------------------------------------
// Background jobs — Phase 5 (payslip PDFs). Company-scoped so listings stay tenant-safe;
// the worker runs them under a system scope.
// ---------------------------------------------------------------------------

enum JobType {
  GENERATE_PAYSLIP_PDFS
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

model Job {
  id          String    @id @default(uuid(7)) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  type        JobType
  payload     Json
  status      JobStatus @default(QUEUED)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  /// Units done / total (e.g. payslips rendered), for the progress bar.
  done        Int       @default(0)
  total       Int       @default(0)
  error       String?
  runAt       DateTime  @default(now()) @map("run_at") @db.Timestamptz(3)
  startedAt   DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(3)
  createdById String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([companyId, createdAt])
  @@map("jobs")
}
