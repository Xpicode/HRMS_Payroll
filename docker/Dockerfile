# syntax=docker/dockerfile:1.7
# Production image (Phase 8): multi-stage, non-root runtime, Chromium for payslip PDFs.
#
#   docker build -f docker/Dockerfile -t hrms-payroll:latest --build-arg APP_VERSION=$(git rev-parse --short HEAD) .
#
# Stages
#   base     Playwright's Ubuntu image (Node 24 + pnpm) — build tooling only.
#   deps     pnpm install (frozen lockfile). Prisma Client is generated by the postinstall hook.
#   build    next build → .next/standalone (a self-contained server with only the modules it needs).
#   tools    a small, plain node_modules tree with the Prisma CLI and tsx, used by the entrypoint
#            for `prisma migrate deploy` and the seed (the standalone server has neither).
#   runtime  node:24-slim + Chromium and its libraries (`playwright install --with-deps chromium`,
#            nothing for Firefox/WebKit) + the standalone server, static assets and tools, owned by
#            `pwuser`; tini as PID 1 reaps Chromium children.
#
# PLAYWRIGHT_VERSION must equal the `playwright` version in package.json: the runtime installs
# exactly that Chromium build under /ms-playwright.

ARG PLAYWRIGHT_VERSION=1.63.0

FROM mcr.microsoft.com/playwright:v${PLAYWRIGHT_VERSION}-noble AS base
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    CI=true \
    NEXT_TELEMETRY_DISABLED=1
RUN npm install -g pnpm@11.21.0

# ---------------------------------------------------------------------------
FROM base AS deps
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml prisma.config.ts ./
COPY prisma ./prisma
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile

# ---------------------------------------------------------------------------
FROM deps AS build
COPY . .
# `next build` imports route modules to collect metadata; the Prisma client is constructed at import
# time and insists on a DATABASE_URL, so a placeholder is given. Nothing connects during the build.
ENV NODE_ENV=production \
    DATABASE_URL=postgresql://build:build@localhost:5432/build?schema=public
RUN pnpm build

# ---------------------------------------------------------------------------
FROM base AS tools
WORKDIR /tools
COPY docker/tools/package.json docker/tools/pnpm-lock.yaml docker/tools/pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --prod

# ---------------------------------------------------------------------------
FROM node:24-bookworm-slim AS runtime
ARG PLAYWRIGHT_VERSION
ARG APP_VERSION=dev
ENV NODE_ENV=production \
    PORT=8080 \
    HOSTNAME=0.0.0.0 \
    DATA_DIR=/data \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    NEXT_TELEMETRY_DISABLED=1 \
    APP_VERSION=${APP_VERSION}

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tini util-linux \
    && npx -y playwright@${PLAYWRIGHT_VERSION} install --with-deps chromium \
    && apt-get clean && rm -rf /var/lib/apt/lists/* /root/.npm /root/.cache \
    && groupadd -g 1001 pwuser && useradd -u 1001 -g pwuser -m -s /bin/bash pwuser \
    && chmod -R a+rX /ms-playwright

WORKDIR /app

# Server
COPY --from=build --chown=pwuser:pwuser /app/.next/standalone ./
COPY --from=build --chown=pwuser:pwuser /app/.next/static ./.next/static
COPY --from=build --chown=pwuser:pwuser /app/public ./public

# Migrations + seed (run by the entrypoint before the server starts)
COPY --from=tools --chown=pwuser:pwuser /tools/node_modules ./tools/node_modules
COPY --from=build --chown=pwuser:pwuser /app/src/generated ./tools/src/generated
# The seed imports the password helpers (EMPLOYEE_TEMP_PASSWORD); bcryptjs is in tools/node_modules.
COPY --chown=pwuser:pwuser src/lib/password.ts ./tools/src/lib/password.ts
COPY --chown=pwuser:pwuser prisma ./tools/prisma
COPY --chown=pwuser:pwuser prisma.config.ts ./tools/prisma.config.ts

COPY docker/entrypoint.sh /usr/local/bin/hrms-entrypoint
RUN chmod 0755 /usr/local/bin/hrms-entrypoint \
    && mkdir -p /data && chown pwuser:pwuser /data && chmod 0750 /data

VOLUME ["/data"]
EXPOSE 8080

# The entrypoint starts as root only to fix /data ownership on bind mounts, then drops to pwuser.
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:8080/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/hrms-entrypoint"]
