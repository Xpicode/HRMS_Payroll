# Development image. Playwright's base image ships Chromium and its system
# dependencies, which Phase 5 (PDF rendering) needs. Node comes with the image.
# The production multi-stage, non-root image is a Phase 8 deliverable.
FROM mcr.microsoft.com/playwright:v1.63.0-noble

ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    CI=true \
    NEXT_TELEMETRY_DISABLED=1

RUN npm install -g pnpm@11.21.0 && pnpm --version

WORKDIR /app

# Source is bind-mounted at runtime (see docker-compose.yml); node_modules and .next
# live in named volumes so Linux binaries never collide with the host's.
EXPOSE 3000
CMD ["/app/docker/dev-entrypoint.sh"]
