# Copy to .env and fill in. Never commit .env.

# --- Database (Docker Compose uses the same values for the db service) ---
POSTGRES_USER=hrms
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=hrms
# Host port for the db container (5433 by default; 5432 is often taken by a local Postgres).
POSTGRES_HOST_PORT=5433
# From the host (pnpm dev): localhost:POSTGRES_HOST_PORT. Inside Docker Compose the app uses db:5432.
DATABASE_URL=postgresql://hrms:change-me-strong-db-password@localhost:5433/hrms?schema=public

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-32-random-bytes-base64
# Public URL of the app (scheme + host + port). Behind HTTPS in production.
# Use https://localhost:8080 together with `pnpm dev:https` (LAN access with a local certificate).
AUTH_URL=http://localhost:8080
AUTH_TRUST_HOST=true
# Dev only: other hosts allowed to open the dev server (e.g. another PC on the LAN).
# Comma-separated hostnames or IPs; "*" wildcards allowed. Ignored by production builds.
DEV_ALLOWED_ORIGINS=192.168.0.*

# --- First admin (used by db:seed only; must change password on first login) ---
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=System Administrator
ADMIN_PASSWORD=ChangeMe-Now-2026!

# Seed a DEMO company with 5 employees (set to false in production)
SEED_DEMO_COMPANY=true

# --- Storage (uploads, later payslip PDFs). Inside Docker this is /data. ---
DATA_DIR=./data

# --- Sessions / security ---
# Absolute session lifetime (sign in again after this long) and idle timeout (no request for this long).
SESSION_MAX_AGE_SECONDS=28800
SESSION_IDLE_SECONDS=7200
# Login throttles per client IP and per account within LOGIN_WINDOW_SECONDS; then the account lockout below.
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=15
LOGIN_WINDOW_SECONDS=900
ACCOUNT_LOCK_AFTER_FAILURES=10
ACCOUNT_LOCK_MINUTES=15

# --- App ---
APP_TZ=Asia/Manila

# --- Background jobs (payslip PDFs) ---
# The compose `jobs` sidecar calls POST /api/jobs/run every minute with this token.
# Generate with: openssl rand -hex 24
JOBS_TOKEN=replace-with-48-random-hex-characters

# --- Email outbox (Phase 7): each employee gets their payslip PDF. Off per company by default. ---
# Leave SMTP_HOST empty to disable. SMTP_HOST=json logs messages instead of sending (dev/tests).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Payroll <payroll@example.com>

# --- Backups (scripts/backup.sh, scripts/restore.sh) ---
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

# --- Production (docker-compose.prod.yml; see docs/deployment.md) ---
# Where the reverse proxy reaches the app. Keep 127.0.0.1 unless the proxy runs on another host.
APP_BIND=127.0.0.1
APP_PORT=8080
# Memory cap for the app container (Chromium renders the PDFs).
APP_MEM_LIMIT=2g
# Host folders for bind mounts instead of the named volumes (Synology: /volume1/docker/hrms/...).
#HRMS_DATA_PATH=/volume1/docker/hrms/data
#HRMS_PGDATA_PATH=/volume1/docker/hrms/pgdata
# Image tag / version stamp shown by /api/health (set by the build).
#APP_IMAGE=hrms-payroll:latest
#APP_VERSION=
# Linux VPS with the Caddy overlay (docker-compose.caddy.yml): public hostname for the certificate.
#SITE_ADDRESS=payroll.example.com
